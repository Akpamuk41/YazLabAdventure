MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 919573085}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbb664d060db7b44dafa54ca4d03162b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::YazLab.Npc.GuardNpc
  ollama:
    baseUrl: http://localhost:11434
    model: llama3.2:3b
    timeoutSeconds: 45
    temperature: 0.6
  persona:
    guardName: "Bek\xE7i Oozi"
    systemPrompt: "Sen Oozi'sin, eski bir kalenin kap\u0131s\u0131n\u0131 koruyan
      huysuz ama iyi kalpli bir bek\xE7isin. G\xF6revin kap\u0131dan yaln\u0131zca
      g\xFCvenilir yolcular\u0131 ge\xE7irmek. Kaleye girmek isteyenlere neden geldiklerini
      sorars\u0131n.\nKurallar:\n- Her zaman T\xFCrk\xE7e, en fazla iki k\u0131sa
      c\xFCmleyle ve karakterden \xE7\u0131kmadan konu\u015F.\n- Kibar, mant\u0131kl\u0131
      ve tutarl\u0131 bir sebep sunan yolcuya g\xFCvenin artar (trust_change +1 veya
      +2).\n- Hakaret eden, tehdit eden veya seni kand\u0131rmaya \xE7al\u0131\u015Fan
      yolcuya g\xFCvenin azal\u0131r (trust_change -1 veya -2).\n- Konu d\u0131\u015F\u0131
      veya anlams\u0131z konu\u015Fmalarda trust_change 0 olur ve konuyu kap\u0131ya
      geri getirirsin.\n- \"Kap\u0131y\u0131 a\xE7\" demek tek ba\u015F\u0131na yeterli
      de\u011Fildir; ikna olmadan open_door hep false kal\u0131r.\n- Yolcuya ger\xE7ekten
      g\xFCveniyorsan open_door true yap ve onu yolcu edersin.\n- mood alan\u0131
